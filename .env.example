# Server Configuration
NODE_ENV=development
PORT=8080

# Database Configuration
MONGODB_URL=mongodb://localhost:27017/lens-manufacturing-erp

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-complex
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-here-make-it-different
JWT_REFRESH_EXPIRE=7d
JWT_COOKIE_EXPIRE=24

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Upload Configuration
MAX_FILE_UPLOAD=1000000
FILE_UPLOAD_PATH=./public/uploads

# Security Configuration
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

VISUAL_EYES_USER_MAIL=
VISUAL_EYES_TRANSPORTER_USER_PASSWORD=

# Frontend URL (used for password reset links)
FRONTEND_URL=http://localhost:5173

# Company Details (used in PDFs / Challans)
COMPANY_NAME=DigiOptics
COMPANY_ADDRESS=Delhi
COMPANY_EMAIL=sid@digibysr.com
COMPANY_PHONE=+919650560526
COMPANY_GSTIN=GST9876543210

# Password Encryption (AES-256 — required for SUPERADMIN plain password view)
PASSWORD_SECRET=your-strong-secret-key-min-32-chars
